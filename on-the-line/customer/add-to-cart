<?php
session_start();
require_once '../config/database.php';

// Check if user is logged in
if (!isset($_SESSION['user_id'])) {
    $_SESSION['error'] = 'Please login to add items to cart';
    header('Location: ../login.php');
    exit;
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && isset($_POST['product_id'])) {
    $productId = (int)$_POST['product_id'];
    $userId = $_SESSION['user_id'];
    
    try {
        $database = new Database();
        $db = $database->getConnection();
        
        // Check if product exists and is available
        $stmt = $db->prepare("SELECT id, status FROM products WHERE id = :id AND status = 'available'");
        $stmt->execute([':id' => $productId]);
        $product = $stmt->fetch();
        
        if (!$product) {
            $_SESSION['error'] = 'Product is not available for reservation.';
            header('Location: ../index.php');
            exit;
        }
        
        // Check if product already in cart
        $stmt = $db->prepare("SELECT id FROM reservation_carts WHERE user_id = :user_id AND product_id = :product_id");
        $stmt->execute([':user_id' => $userId, ':product_id' => $productId]);
        
        if ($stmt->fetch()) {
            $_SESSION['message'] = 'Product is already in your reservation cart.';
        } else {
            // Add to cart
            $stmt = $db->prepare("INSERT INTO reservation_carts (user_id, product_id) VALUES (:user_id, :product_id)");
            $stmt->execute([':user_id' => $userId, ':product_id' => $productId]);
            $_SESSION['message'] = 'Product added to your reservation cart!';
        }
        
        header('Location: cart.php');
        exit;
        
    } catch (PDOException $e) {
        $_SESSION['error'] = 'Database error. Please try again.';
        header('Location: ../index.php');
        exit;
    }
} else {
    header('Location: ../index.php');
    exit;
}
?>